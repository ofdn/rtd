{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.org/schema/person.schema.json",
  "title": "Person",
  "description": "A type designer or other professional involved in creating typefaces, digital or pre-digital.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "slug",
    "name",
    "roles",
    "sources",
    "record_status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^RTD-P-[0-9]{6}$",
      "description": "Permanent opaque identifier. Never reused, never changed once assigned."
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "URL/filename-friendly slug. May change if a record is renamed; id does not."
    },
    "name": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preferred"],
      "properties": {
        "preferred": { "type": "string", "minLength": 1 },
        "alternates": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        }
      }
    },
    "sort_name": {
      "type": "string",
      "description": "Name form used for alphabetical listing, useful for non-Latin or family-name-first names."
    },
    "birth_year": {
      "type": "string",
      "description": "Free-form to allow uncertain precision, e.g. '1901' or 'c. 1890'."
    },
    "death_year": {
      "type": "string"
    },
    "countries": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "e.g. type designer, punchcutter, calligrapher, type engineer."
    },
    "active_years": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": { "type": "string" },
        "end": { "type": "string" }
      }
    },
    "scripts": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "Writing systems worked in."
    },
    "affiliations": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "start_year": { "type": "string" },
          "end_year": { "type": "string" }
        }
      }
    },
    "bio": {
      "type": "string",
      "maxLength": 1000,
      "description": "Short plain-text summary, a few sentences. Not a full biography."
    },
    "external_ids": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wikidata_qid": { "type": "string", "pattern": "^Q[0-9]+$" },
        "viaf": { "type": "string" },
        "isni": { "type": "string" }
      },
      "description": "Informational cross-references only. Never usable as a sources entry."
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "title"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "title": { "type": "string", "minLength": 1 }
        }
      },
      "description": "Independent, verifiable sources. Must never be Wikidata, Wikipedia, or any Wikimedia project — enforced by scripts/validate.js."
    },
    "record_status": {
      "type": "string",
      "enum": ["active", "merged", "deprecated"]
    },
    "superseded_by": {
      "type": ["string", "null"],
      "pattern": "^RTD-P-[0-9]{6}$"
    },
    "created_at": { "type": "string", "format": "date" },
    "updated_at": { "type": "string", "format": "date" }
  }
}
